# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooparse-bin
_pkgname=ooparse
pkgver=0.1.0
pkgrel=1
pkgdesc="General purpose parser generating AST graphs from custom grammar expressions."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooparse"
license=('Apache-2.0')
depends=('glibc')
provides=('ooparse')
conflicts=('ooparse')
source_x86_64=("${url}/releases/download/v${pkgver}/ooparse-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooparse-linux-x86_64" "${pkgdir}/usr/bin/ooparse"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooparse-uninstall"
}
